<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="24dp" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="Flashcard Quiz" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/email" android:hint="Email" android:inputType="textEmailAddress" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/password" android:hint="Password" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/login" android:text="Login" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/toRegister" android:text="Create account / Register" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
